#History {
    width: 100%;
    height: 100%;
    min-height: 88%;
    max-height: 92% padding 0;
    margin: 0px;
    margin-top: 20px;
    background-color: yellow;
    border-radius: 0 0 14px 14px;
    margin-bottom: 15px;
}

#HistoryTittleBar {
    position: absolute;
    width: 100%;
    height: 20px;
    background-color: red;
    border-radius: 14px 14px 0 0;
    padding: 0px;
    margin: 0px;
}

#Inputs {
    width: 100%;
    height: 55px;
    color: red;
    background-color: black;
    z-index: 500;
    padding-right: 10px;
    padding-left: 10px;
    -unity-text-align: middle-left;
}

Label {
    white-space: normal;
    overflow: hidden;
}

#SpawnWords{
    overflow: hidden;
}
