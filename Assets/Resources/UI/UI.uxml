<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/Resources/UI/UI.uss?fileID=7433441132597879392&amp;guid=d8a53fae93b33ed47965de93b31bdce0&amp;type=3#UI"/>
    <ui:VisualElement style="flex-grow: 1;">
        <ui:VisualElement name="Desktop" style="flex-grow: 1; position: absolute; background-color: rgb(161, 136, 136); top: 0; right: 0; bottom: 0; left: 0; justify-content: center; align-self: center; align-items: center; width: 100%; height: 100%;"/>
        <ui:VisualElement name="Content" style="flex-grow: 1; justify-content: flex-end; margin-bottom: 0; margin-left: 0; margin-right: 0;">
            <ui:Label text="000" name="ScorePoints" selectable="true" focusable="true" tabindex="90" style="position: absolute; top: 0; right: 0; left: 0; -unity-text-align: upper-center; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; color: rgb(204, 204, 204); -unity-font-style: bold; -unity-font-definition: url(&quot;project://database/Assets/Fonts/JetBrainsMono-2.304/fonts/ttf/JetBrainsMonoNL-Light.ttf?fileID=12800000&amp;guid=5d70121e525336b49bccb6a4275a9568&amp;type=3#JetBrainsMonoNL-Light&quot;);"/>
            <ui:VisualElement name="HistoryContainer" style="flex-grow: 1; position: absolute; left: 0; bottom: 0; top: 0; margin-top: 40px; margin-right: 15px; margin-bottom: 15px; margin-left: 15px; min-width: 25%;">
                <ui:VisualElement name="HistoryTittleBar" style="flex-grow: 1; position: absolute;">
                    <ui:Label text="History" style="-unity-text-align: middle-center; font-size: 12px; -unity-font-style: bold; -unity-font-definition: url(&quot;project://database/Assets/Fonts/JetBrainsMono-2.304/fonts/ttf/JetBrainsMono-Medium.ttf?fileID=12800000&amp;guid=9ecc5f2f3d597f44989b0c5d61628bab&amp;type=3#JetBrainsMono-Medium&quot;);"/>
                </ui:VisualElement>
                <ui:ScrollView name="History" style="top: 0; bottom: auto; min-height: auto; max-height: 97%; position: absolute; margin-top: 20px;"/>
            </ui:VisualElement>
            <ui:VisualElement name="Terminal" style="flex-grow: 1; position: absolute; right: 0; top: 0; bottom: 0; width: 70%; min-width: 70%; max-width: 70%; margin-top: 40px; margin-right: 15px; margin-bottom: 15px; margin-left: 15px; justify-content: flex-start;">
                <ui:VisualElement name="TerminalTittleBar" style="flex-grow: 1; height: 20px; min-height: 20px; max-height: 20px; background-color: rgba(0, 0, 210, 0.75); border-top-left-radius: 14px; border-top-right-radius: 14px;">
                    <ui:Label text="Terminal" style="-unity-text-align: middle-center; -unity-font-definition: url(&quot;project://database/Assets/Fonts/JetBrainsMono-2.304/fonts/ttf/JetBrainsMonoNL-Medium.ttf?fileID=12800000&amp;guid=4b5457929b7ef3b41ae8c850850d1548&amp;type=3#JetBrainsMonoNL-Medium&quot;);"/>
                </ui:VisualElement>
                <ui:VisualElement name="TerminalContent" style="flex-grow: 1;">
                    <ui:VisualElement name="TerminalBackground" style="flex-grow: 1; background-color: rgba(0, 0, 0, 0.65);"/>
                    <ui:Label text="Label" name="Inputs" tabindex="90" style="margin-bottom: 0; bottom: 0; margin-left: 0; margin-right: 0; border-top-left-radius: 0; border-top-right-radius: 0; border-bottom-right-radius: 14px; border-bottom-left-radius: 14px; margin-top: 0; width: 100%; position: relative; border-top-width: 3px; border-top-color: rgba(255, 255, 255, 0.27);"/>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="SpawnWords" style="flex-grow: 1; position: absolute; right: 0; top: 0; bottom: 0; width: 70%; min-width: 70%; max-width: 70%; margin-top: 60px; margin-right: 15px; margin-bottom: 70px; margin-left: 15px; justify-content: flex-end;"/>
        <ui:VisualElement enabled="true" name="Finished" focusable="false" style="flex-grow: 1; position: absolute; right: 0; left: 0; bottom: 0; top: 0; justify-content: center; align-self: center; align-items: center; opacity: 1; visibility: visible; display: none;">
            <ui:VisualElement name="ScoreTittleBar" style="flex-grow: 1; height: 20px; min-height: 20px; max-height: 20px; background-color: rgba(0, 0, 210, 0.75); border-top-left-radius: 14px; border-top-right-radius: 14px; width: 45%;">
                <ui:Label text="Score" style="-unity-text-align: middle-center; -unity-font-definition: url(&quot;project://database/Assets/Fonts/JetBrainsMono-2.304/fonts/ttf/JetBrainsMono-Medium.ttf?fileID=12800000&amp;guid=9ecc5f2f3d597f44989b0c5d61628bab&amp;type=3#JetBrainsMono-Medium&quot;);"/>
            </ui:VisualElement>
            <ui:VisualElement name="Container" style="flex-grow: 1; top: auto; bottom: auto; left: auto; right: auto; width: 45%; height: 70%; min-height: 70%; max-height: 70%; background-color: rgb(0, 0, 0); align-items: center; align-self: center; justify-content: space-around;">
                <ui:Label text="3500" enabled="true" name="Score" style="background-color: rgb(0, 0, 0); color: rgb(255, 255, 255); -unity-text-align: upper-center; -unity-font-definition: url(&quot;project://database/Assets/Fonts/JetBrainsMono-2.304/fonts/ttf/JetBrainsMonoNL-Medium.ttf?fileID=12800000&amp;guid=4b5457929b7ef3b41ae8c850850d1548&amp;type=3#JetBrainsMonoNL-Medium&quot;); font-size: 45px;"/>
                <ui:VisualElement style="flex-grow: 1; height: auto; max-height: 30%;">
                    <ui:Label text="Press Q to exit" style="color: rgb(255, 255, 255); -unity-font-definition: url(&quot;project://database/Assets/Fonts/JetBrainsMono-2.304/fonts/ttf/JetBrainsMonoNL-Medium.ttf?fileID=12800000&amp;guid=4b5457929b7ef3b41ae8c850850d1548&amp;type=3#JetBrainsMonoNL-Medium&quot;); font-size: 18px;"/>
                    <ui:Label text="Press R to restart" style="color: rgb(255, 255, 255); -unity-font-definition: url(&quot;project://database/Assets/Fonts/JetBrainsMono-2.304/fonts/ttf/JetBrainsMonoNL-Medium.ttf?fileID=12800000&amp;guid=4b5457929b7ef3b41ae8c850850d1548&amp;type=3#JetBrainsMonoNL-Medium&quot;); font-size: 18px; height: 32px;"/>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
