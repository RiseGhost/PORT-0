<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:VisualElement name="Content" style="flex-grow: 1; padding-top: 10px; padding-bottom: 10px; padding-left: 10px; padding-right: 10px; height: auto; min-height: auto;">
        <ui:Label text="Label" name="Command" style="-unity-text-align: middle-center; margin-bottom: 10px; font-size: 20px; -unity-font-style: bold;" />
        <ui:Label text="Label" name="Description" />
    </ui:VisualElement>
</ui:UXML>
