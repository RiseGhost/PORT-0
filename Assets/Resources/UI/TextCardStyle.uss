.unity-progress-bar{
    margin: 0px;
    padding: 0px;
}

.unity-progress-bar__container {
    background-color:red;
    height: 100%;
    min-height: 100%;
    background-color: rgba(0, 0, 0, 0)
}

.unity-progress-bar__background{
    margin: 0px;
    border-radius: 10px;
    border: none;
    background-color: rgba(255, 100, 0, 0.9);
}

.unity-progress-bar__progress{
    margin: 0px;
    padding: 0px;
    border-radius: 10px;
    background-color: rgb(80,80,80);
}