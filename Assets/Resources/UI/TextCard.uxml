    <ui:VisualElement name="Content" style="flex-grow: 1; position: absolute; width: 250px; height: 60px; background-color: rgb(255, 114, 114); -unity-text-align: middle-center; white-space: normal; text-overflow: clip; justify-content: center; border-top-left-radius: 10px; border-top-right-radius: 10px; border-bottom-right-radius: 10px; border-bottom-left-radius: 10px; border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0; border-left-color: rgb(0, 0, 0); border-right-color: rgb(0, 0, 0); border-top-color: rgb(0, 0, 0); border-bottom-color: rgb(0, 0, 0);">
        <ui:ProgressBar value="0" enabled="true" high-value="1" language-direction="Inherit" focusable="false" tabindex="0" usage-hints="None" name="Progress" style="position: absolute; top: 0; bottom: 0; right: 0; left: 0; flex-grow: 0; flex-shrink: 0; border-top-left-radius: 10px; border-top-right-radius: 10px; border-bottom-right-radius: 10px; border-bottom-left-radius: 10px;" />
        <ui:VisualElement style="flex-grow: 1; color: rgb(166, 221, 168); left: 0; right: 0; bottom: 0; top: 0; -unity-background-image-tint-color: rgb(13, 158, 185); position: absolute; background-image: url(&quot;project://database/Assets/Subtract.png?fileID=2800000&amp;guid=76aee2f072795a64091fbbaec453f91f&amp;type=3#Subtract&quot;); border-top-left-radius: 10px; border-top-right-radius: 10px; border-bottom-right-radius: 10px; border-bottom-left-radius: 10px;" />
        <ui:Label text="Label" name="word" style="-unity-text-align: middle-center; -unity-font-style: bold; position: absolute; right: 0; left: 0; top: 0; bottom: 0; margin-left: 0; margin-top: 0; margin-right: 0; margin-bottom: 0; padding-bottom: 0; padding-top: 0; padding-left: 0; padding-right: 0;" />
    </ui:VisualElement>
